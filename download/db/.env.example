# ─────────────────────────────────────────────────────────────────────────────
# ShiftGrid environment variables
# Copy to `.env` (or `.env.local` for Next.js) and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# Database — Neon Postgres connection string
DATABASE_URL=postgres://user:password@ep-xxxxx.region.aws.neon.tech/shiftgrid?sslmode=require

# Direct connection (for migrations — bypasses pooling)
DIRECT_URL=postgres://user:password@ep-xxxxx.region.aws.neon.tech/shiftgrid?sslmode=require

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-byte-random-string

# Google OAuth (for real "Continue with Google" — get from Google Cloud Console)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 4. Copy the Client ID and Secret here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email service (Postmark or SendGrid — leave empty for demo mode)
# Demo mode: verification codes are displayed in the UI instead of emailed
POSTMARK_API_KEY=
EMAIL_FROM="ShiftGrid <noreply@yourdomain.com>"

# File storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
