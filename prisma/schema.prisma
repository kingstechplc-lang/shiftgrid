// ShiftGrid — Healthcare staffing marketplace schema
// Adapted to Prisma + SQLite per project conventions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id            String   @id @default(cuid())
  name          String
  description   String?
  logoUrl       String?
  bannerUrl     String?
  coverPhotoUrl String?
  address       String?
  website       String?
  verified      Boolean  @default(false)
  status        String   @default("active")  // "active" | "suspended" | "banned"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members  User[]
  offers   Offer[]
}

enum Role {
  super_admin
  hospital_admin
  staff
}

enum OfferType {
  locum
  permanent
}

enum OfferStatus {
  draft
  published
  closed
  filled
}

enum Visibility {
  public
  internal
}

enum ApplicationStatus {
  applied
  under_review
  shortlisted
  offered
  accepted
  declined
  withdrawn
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  name            String
  role            Role     @default(staff)
  authProvider    String   @default("local")  // "local" | "google"
  emailVerified   DateTime?
  status          String   @default("active")  // "active" | "suspended" | "banned"
  registrationId  String?  @unique  // e.g. "SG-STAFF-00001", "SG-ADMIN-00001"
  website         String?
  canReceiveMessages String? @default("true") // super admin toggle: "true" | "false"
  hospitalId      String?
  hospital        Hospital? @relation(fields: [hospitalId], references: [id])
  specialty       String?
  specialtyOther  String?  // when specialty is "Other"
  experienceYears Int?
  resumeUrl       String?
  availability    String?
  bio             String?
  location        String?
  preferredTypes  String?  // comma-separated "locum,permanent"
  offerTypes      String?  // comma-separated "locum,permanent,both" — what admin can post
  // Personal info
  profilePhoto    String?
  coverPhotoUrl   String?
  phoneNumber     String?
  dateOfBirth     DateTime?
  gender          String?
  // Address info (Ghana)
  region          String?
  district        String?
  townCity        String?
  streetAddress   String?
  landmark        String?
  digitalAddress  String?  // GhanaPost GPS format e.g. GA-123-4567
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications  Application[]
  credentials   Credential[]
  sentMessages  Message[]     @relation("MessageSender")
  receivedMessages Message[]  @relation("MessageRecipient")
  notifications Notification[]
  savedOffers   SavedOffer[]
  offersCreated Offer[]
  verificationTokens VerificationToken[]
  bannersCreated PlatformBanner[] @relation("BannerCreator")
  mediaUploaded  MediaAsset[] @relation("MediaUploader")
  adConfigsUpdated AdConfig[] @relation("AdConfigUpdater")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique  // long token for email link
  code      String   // 6-digit code for manual entry
  type      String   @default("email_verification")  // "email_verification" | "password_reset"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Offer {
  id             String       @id @default(cuid())
  hospitalId     String
  hospital       Hospital     @relation(fields: [hospitalId], references: [id])
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  type           OfferType
  title          String
  specialty      String?
  description    String?
  requirements   String?      // JSON string array
  location       String?
  bannerUrl      String?
  status         OfferStatus  @default(draft)
  visibility     Visibility   @default(public)
  deadline       DateTime?

  // locum-only
  shiftStart     DateTime?
  shiftEnd       DateTime?
  rate           Float?
  rateUnit       String?
  urgent         Boolean      @default(false)

  // permanent-only
  employmentType String?
  salaryMin      Int?
  salaryMax      Int?
  benefits       String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  applications Application[]
  savedBy      SavedOffer[]
  messages     Message[]
  auditEvents  AuditEvent[]
}

model Application {
  id        String            @id @default(cuid())
  offerId   String
  offer     Offer             @relation(fields: [offerId], references: [id])
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  status    ApplicationStatus @default(applied)
  coverNote String?
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([offerId, userId])
}

model Credential {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       String    // license | certification | resume | id
  name       String
  fileUrl    String
  issueDate  DateTime?
  expiryDate DateTime?
  verified   Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model Message {
  id          String   @id @default(cuid())
  offerId     String?
  offer       Offer?   @relation(fields: [offerId], references: [id])
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  payload   String?  // JSON
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SavedOffer {
  userId    String
  offerId   String
  createdAt DateTime @default(now())
  user      User    @relation(fields: [userId], references: [id])
  offer     Offer   @relation(fields: [offerId], references: [id])

  @@id([userId, offerId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id])
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

model PlatformBanner {
  id              String   @id @default(cuid())
  title           String
  desktopImageUrl String?
  mobileImageUrl  String?
  targetUrl       String?
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  startDate       DateTime?
  endDate         DateTime?
  createdById     String
  createdBy       User     @relation("BannerCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String   @unique
  type         String   // "profile_photo" | "cover_photo" | "facility_logo" | "facility_cover" | "shift_banner" | "hero_desktop" | "hero_mobile" | "announcement" | "document"
  uploadedById String?
  uploader     User?    @relation("MediaUploader", fields: [uploadedById], references: [id])
  fileSize     Int?
  width        Int?
  height       Int?
  mimeType     String?
  createdAt    DateTime @default(now())
}

model AdConfig {
  id           String   @id @default(cuid())
  slotName     String   @unique  // "skyscraper" | "leaderboard" | "mobile_banner" | "native"
  label        String   // human-readable label
  enabled      Boolean  @default(true)
  adKey        String?  // Adsterra key (e.g. "435fa794ab27249e1ebebea502a8ebe2")
  adScriptSrc  String?  // full script URL
  width        Int?
  height       Int?
  adType       String   @default("atoptions") // "atoptions" | "native" | "custom"
  customCode   String?  // for custom ad scripts
  updatedAt    DateTime @updatedAt
  updatedById  String?
  updatedBy    User?    @relation("AdConfigUpdater", fields: [updatedById], references: [id])
}

